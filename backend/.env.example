# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database ---
# MongoDB Atlas cluster connection string (must be a replica set - register/Google-login use a
# transaction, and Atlas clusters already satisfy that by default).
DB_URL=mongodb+srv://<user>:<password>@<cluster-host>/storage-app?retryWrites=true&w=majority

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
# CLIENT_URL_1 is also reused as the frontend origin for links embedded in emails (password
# reset) - keep it pointed at your real frontend URL, not just "whatever CORS happens to allow".
CLIENT_URL_1=http://localhost:5173
CLIENT_URL_2=

# --- JWT / Auth ---
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
PASSWORD_RESET_TOKEN_EXPIRY=15m
ACCOUNT_UNLOCK_TOKEN_EXPIRY=15m
EMAIL_VERIFICATION_TOKEN_EXPIRY=30m
CSRF_SECRET=change-me-csrf-secret
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MS=1800000
MAX_SESSIONS_PER_USER=5

# --- OTP ---
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# --- AWS S3 ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_S3_BUCKET=

# --- CloudFront ---
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_URL_EXPIRY_SECONDS=3600

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Storage App <onboarding@resend.dev>

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage defaults ---
DEFAULT_MAX_STORAGE_BYTES=16106127360

# --- Observability ---
LOG_LEVEL=debug
METRICS_TOKEN=
OTEL_SERVICE_NAME=storage-app-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
