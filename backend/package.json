{
  "name": "storage-app-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch --no-deprecation --import ./instrumentation.js --env-file=.env server.js",
    "start": "node --no-deprecation --import ./instrumentation.js server.js",
    "worker": "node --no-deprecation --import ./instrumentation.js src/worker.js",
    "worker:dev": "node --watch --no-deprecation --import ./instrumentation.js --env-file=.env src/worker.js",
    "migrate:up": "migrate-mongo up --file migrate-mongo-config.cjs",
    "migrate:down": "migrate-mongo down --file migrate-mongo-config.cjs",
    "migrate:status": "migrate-mongo status --file migrate-mongo-config.cjs",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Storage App backend (v2) - production-grade file storage API",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/cloudfront-signer": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "mongoose": "^8.12.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.6",
    "resend": "^6.2.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "migrate-mongo": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2"
  }
}
