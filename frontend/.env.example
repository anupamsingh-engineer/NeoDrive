# Backend API (see backend/FRONTEND_INTEGRATION_GUIDE.md)
VITE_API_BASE_URL=http://localhost:4000/
# Same host as above but WITHOUT the trailing slash/path — used only in index.html's CSP
# connect-src, which needs a bare origin (scheme+host+port), not a path.
VITE_API_ORIGIN=http://localhost:4000

# Google Identity Services (Sign in with Google) — must match the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# Razorpay Checkout — public key id (safe to expose client-side), must match the backend's RAZORPAY_KEY_ID
VITE_RAZORPAY_KEY_ID=

# Auth Configuration
VITE_SESSION_TIMEOUT=30

# App Configuration
VITE_APP_NAME=Storage App
VITE_APP_VERSION=1.0.0

# Analytics — providers only initialize when the key is present
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_MIXPANEL_TOKEN=
VITE_HOTJAR_ID=
